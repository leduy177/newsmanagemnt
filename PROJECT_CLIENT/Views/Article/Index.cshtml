@model IEnumerable<PROJECT_CLIENT.DTO.ArticleDto>
@{
    ViewData["Title"] = "Article List";
}

<style>
    h2 {
        color: #6f42c1;
    }

    .btn-purple {
        background-color: #6f42c1;
        color: #fff;
        border: none;
    }

        .btn-purple:hover {
            background-color: #5a36a5;
        }

    .table thead {
        background-color: #eae2f8;
        color: #6f42c1;
    }

    .table-striped > tbody > tr:nth-of-type(odd) {
        background-color: #f9f7fc;
    }

    .search-bar {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .search-input {
        width: 300px;
        padding: 6px 10px;
        border: 1px solid #6f42c1;
        border-radius: 4px;
    }

    .form-select {
        border-color: #6f42c1;
    }
</style>

<h2>Danh sách bài báo</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="get" class="mb-3 search-bar">
    <label for="pageSize">Bản ghi/trang:</label>
    <select name="pageSize" id="pageSize" onchange="this.form.submit()" class="form-select d-inline-block w-auto">
        @foreach (var size in new[] { 3, 5, 10 })
        {
            <option value="@size" selected="@(ViewBag.PageSize == size)">
                @size
            </option>
        }
    </select>

    <input type="text" name="searchTitle" class="search-input" placeholder="Tìm tiêu đề..."
           value="@ViewBag.SearchTitle" />

    <label for="filterTime">Thời gian:</label>
    <select name="filterTime" id="filterTime" class="form-select d-inline-block w-auto ms-2" onchange="this.form.submit()">
        <option value="">-- Tất cả --</option>
        <option value="24h" selected="@(ViewBag.FilterTime == "24h")">Trong 24 giờ</option>
        <option value="7d" selected="@(ViewBag.FilterTime == "7d")">Trong 7 ngày</option>
        <option value="30d" selected="@(ViewBag.FilterTime == "30d")">Trong 30 ngày</option>
    </select>

    <button type="submit" class="btn btn-purple">Tìm kiếm</button>
</form>


<a asp-action="Create" class="btn btn-purple mb-3">Tạo bài báo mới</a>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tiêu đề</th>
            <th>Nội dung</th>
            <th>Nguồn</th>
            <th>Ngày tạo</th>
            <th>Trạng thái</th>
            <th>Thể loại</th>
            <th>Tác giả</th>
            <th>Tags</th>
            <th>Ảnh</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@(item.Title?.Length > 100 ? item.Title.Substring(0, 100) + "..." : item.Title)</td>
                <td>@(item.Content?.Length > 100 ? item.Content.Substring(0, 100) + "..." : item.Content)</td>
                <td>@(item.Source?.Length > 100 ? item.Source.Substring(0, 100) + "..." : item.Source)</td>
                <td>@item.CreatedAt.ToString("dd-MM-yyyy")</td>
                <td>@(item.Status == 1 ? "Xác nhận" : "Ẩn")</td>
                <td>@item.CategoryName</td>
                <td>@item.AuthorName</td>
                <td>@string.Join(", ", item.Tags?.Take(5) ?? Enumerable.Empty<string>())</td>
                <td>@(item.ImageUrl?.Length > 100 ? item.ImageUrl.Substring(0, 100) + "..." : item.ImageUrl)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Xoá</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                       page = i,
                       pageSize = ViewBag.PageSize,
                       searchTitle = ViewBag.SearchTitle,
                       filterTime = ViewBag.FilterTime
                   })">@i</a>
            </li>
        }
    </ul>
</nav>
