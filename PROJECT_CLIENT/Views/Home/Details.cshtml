@using System.Security.Claims
@model PROJECT_CLIENT.DTO.ArticleDto
@{
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? User.FindFirst("role")?.Value;
    ViewData["Title"] = "Chi tiết bài báo";
}

<style>
    .text-purple {
        color: #6f42c1;
    }

    .btn-purple {
        background-color: #6f42c1;
        color: white;
        border: none;
    }

        .btn-purple:hover {
            background-color: #59329d;
        }

    .comment-box {
        background: #f4f1fa;
        border: 1px solid #e2d8f6;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 10px;
    }

    .comment-meta {
        font-size: 0.85rem;
        color: #666;
    }

    .comment-actions {
        float: right;
    }

    .comment-content {
        margin-top: 5px;
    }

    .article-image {
        max-height: 400px;
        object-fit: cover;
        width: 100%;
        border-radius: 8px;
        margin-bottom: 20px;
    }
</style>

<!-- Ảnh đầu bài -->
@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" class="article-image" alt="article image" />
}

<!-- Thông tin bài viết -->
<h2 class="text-purple">@Model.Title</h2>
<p class="mb-1"><strong>Chuyên mục:</strong> @Model.CategoryName</p>
<p class="mb-1"><strong>Tác giả:</strong> @Model.AuthorName</p>
<p class="mb-1"><strong>Tags:</strong> @string.Join(", ", Model.Tags)</p>
<p class="mb-1"><strong>Nguồn:</strong> @Model.Source</p>
<p class="mb-3"><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>

<div class="border rounded p-3 mb-4" style="background-color: #f8f8fc">
    <p class="mb-0">@Model.Content</p>
</div>

<!-- Thông báo -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Bình luận -->
<h4 class="text-purple">🗨️ Bình luận (@Model.Comments.Count)</h4>

<ul class="list-unstyled">
    @foreach (var c in Model.Comments)
    {
        <li class="comment-box">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="comment-meta">
                        <strong>@c.UserFullName</strong> • @c.PostedAt.ToString("dd/MM/yyyy HH:mm")
                    </div>
                    <div class="comment-content">@c.Content</div>
                </div>

                @if (currentUserId == c.UserId || userRole == "MODERATOR")
                {
                    <div class="dropdown ms-2">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                            ⋮
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (currentUserId == c.UserId)
                            {
                                <li class="px-3 py-2">
                                    <form method="post" asp-action="EditComment" asp-controller="Home">
                                        <input type="hidden" name="Id" value="@c.Id" />
                                        <input type="text" name="Content" value="@c.Content" class="form-control mb-2" />
                                        <button type="submit" class="btn btn-sm btn-warning w-100">Lưu chỉnh sửa</button>
                                    </form>
                                </li>
                            }
                            <li class="px-3 py-2">
                                <form method="post" asp-action="DeleteComment" asp-controller="Home" onsubmit="return confirm('Bạn có chắc chắn muốn xoá bình luận này?')">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger w-100">
                                        @((currentUserId == c.UserId) ? "Xoá" : "MOD Xoá")
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </li>
    }
</ul>

<!-- Thêm bình luận -->
<hr />
@if (User.Identity.IsAuthenticated)
{
    <form method="post" asp-action="AddComment">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ArticleId" value="@Model.Id" />
        <div class="form-group mb-2">
            <label for="Content" class="text-purple">Thêm bình luận</label>
            <textarea name="Content" class="form-control" rows="3" required></textarea>
        </div>
        <button type="submit" class="btn btn-purple">Gửi bình luận</button>
    </form>
}
else
{
    <p><em>Bạn cần <a asp-controller="Account" asp-action="Login" class="text-purple fw-bold">đăng nhập</a> để bình luận.</em></p>
}

<!-- Danh sách User liên quan -->
<h4 class="mt-5 text-purple">👥 Danh sách thành viên liên quan</h4>
<table class="table table-bordered table-hover shadow-sm">
    <thead class="table-purple text-white" style="background-color: #6f42c1;">
        <tr>
            <th>UserName</th>
            <th>Vai trò</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ua in Model.UserArticles)
        {
            <tr>
                <td>@ua.UserName</td>
                <td>@ua.RoleInArticle</td>
            </tr>
        }
    </tbody>
</table>
