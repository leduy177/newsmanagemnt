@model PROJECT_CLIENT.DTO.UserProfileDto
@{
    ViewBag.Title = "Thông tin tài khoản";
}

<style>
    .text-purple {
        color: #6f42c1;
    }

    .card-border-purple {
        border-left: 5px solid #6f42c1;
        box-shadow: 0 0.125rem 0.25rem rgba(111, 66, 193, 0.3);
    }
</style>

<h2 class="text-purple mb-4">Thông tin người dùng</h2>

<div class="card card-border-purple">
    <div class="card-body">
        <p><strong class="text-purple">Tên đăng nhập:</strong> @Model.UserName</p>
        <p><strong class="text-purple">Họ tên:</strong> @Model.FullName</p>
        <p><strong class="text-purple">Email:</strong> @Model.Email</p>
        <p><strong class="text-purple">Số điện thoại:</strong> @Model.PhoneNumber</p>
        <p><strong class="text-purple">Vai trò:</strong> @Model.Role</p>
    </div>
</div>
