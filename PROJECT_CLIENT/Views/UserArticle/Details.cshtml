@model IEnumerable<PROJECT_CLIENT.DTO.UserArticleDTO>
@{
    ViewBag.Title = "Chi tiết người dùng theo bài báo";
    var articleId = ViewBag.ArticleId;
}



<h2 class="text-purple mb-4">📄 Chi tiết bài báo <strong>#@articleId</strong></h2>
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}


@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-bordered mb-0">
            <thead class="table-light">
                <tr class="text-center">
                    <th>User ID</th>
                    <th>User Name</th>
                    <th>Vai trò</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="align-middle text-center">
                        <td>@item.UserId</td>
                        <td>@item.UserName</td>
                        <td class="fw-semibold text-purple">@item.RoleInArticle</td>
                        <td>
                            <a asp-action="EditRole" asp-route-userId="@item.UserId" asp-route-articleId="@item.ArticleId" class="btn btn-sm btn-warning me-1">
                                <i class="fa fa-edit"></i> Sửa
                            </a>
                            <a asp-action="RemoveUser" asp-route-userId="@item.UserId" asp-route-articleId="@item.ArticleId"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Bạn có chắc muốn xoá người dùng này khỏi bài báo không?');">
                                <i class="fa fa-trash"></i> Xoá
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<p class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        ← Quay lại danh sách
    </a>
</p>

<style>
    .text-purple {
        color: #6f42c1;
    }

    .btn-purple {
        background-color: #6f42c1;
        border-color: #6f42c1;
        color: white;
    }

        .btn-purple:hover {
            background-color: #59329d;
            border-color: #59329d;
        }
</style>
