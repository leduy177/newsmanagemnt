@model IEnumerable<PROJECT_CLIENT.DTO.CategoryDTO>
@{
    ViewData["Title"] = "Danh sách chuyên mục";
}

<style>
    h2 {
        color: #6f42c1;
        font-weight: bold;
    }

    .btn-purple {
        background-color: #6f42c1;
        color: white;
        border: none;
    }

        .btn-purple:hover {
            background-color: #5a36a5;
        }

    .table thead {
        background-color: #ede7f6;
        color: #4a148c;
    }
</style>

<h2><i class="fa-solid fa-folder-open text-purple"></i> @ViewData["Title"]</h2>
<form method="get" class="mb-3 search-bar">
    <label for="pageSize">Bản ghi/trang:</label>
    <select name="pageSize" id="pageSize" onchange="this.form.submit()" class="form-select d-inline-block w-auto">
        @foreach (var size in new[] { 3, 5, 10 })
        {
            <option value="@size" selected="@(ViewBag.PageSize == size)">
                @size
            </option>
        }
    </select>

    <input type="text" name="searchTitle" class="search-input" placeholder="Tìm Chuyên Mục..."
           value="@ViewBag.SearchTitle" />

    <button type="submit" class="btn btn-purple">Tìm kiếm</button>
</form>
<a asp-action="Create" class="btn btn-purple mb-3"><i class="fa-solid fa-plus"></i> Tạo chuyên mục mới</a>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th style="width: 10%;">ID</th>
            <th>Tên chuyên mục</th>
            <th style="width: 20%;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">
                        <i class="fa-solid fa-pen-to-square"></i> Sửa
                    </a>
                    <a href="javascript:void(0);" onclick="confirmDelete('@Url.Action("Delete", new { id = item.Id })')" class="btn btn-sm btn-danger">
                        <i class="fa-solid fa-trash"></i> Xoá
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        function confirmDelete(url) {
            if (confirm("Bạn có chắc chắn muốn xoá chuyên mục này?")) {
                window.location.href = url;
            }
        }
    </script>}
<nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = ViewBag.PageSize, searchTitle = ViewBag.SearchTitle })">@i</a>
            </li>
        }
    </ul>
</nav>